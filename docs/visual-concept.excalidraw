      "updated": 1769561727146,
      "link": null,
      "locked": false,
      "text": "morning-routine.java:\n\npublic void wakeUp() {\n    int snoozesHit = 0;\n    while (snoozesHit < 5) {\n        alarm.snooze();\n        snoozesHit++;\n    }\n    coffee.drink(Coffee.EXTRA_LARGE);\n}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "morning-routine.java:\n\npublic void wakeUp() {\n    int snoozesHit = 0;\n    while (snoozesHit < 5) {\n        alarm.snooze();\n        snoozesHit++;\n    }\n    coffee.drink(Coffee.EXTRA_LARGE);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
